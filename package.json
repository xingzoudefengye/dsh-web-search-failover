{
  "name": "dsh-web-search-failover",
  "version": "0.1.1",
  "description": "Failover web search for DeepSeek Harness: try backends in order, fall back when one fails or returns no results.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-search-deepseek": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "dev-link": "node scripts/dev-link.mjs"
  }
}
